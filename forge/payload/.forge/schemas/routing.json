{
  "schema": "forge/routing/2",
  "note": "The routing matrix as data. forge-status and forge-planner read this; humans read ROUTING.md. Model values are aliases (haiku|sonnet|opus|fable); effort is low|medium|high|xhigh|max.",
  "tiers": ["haiku", "sonnet", "opus", "fable"],
  "efforts": ["low", "medium", "high", "xhigh", "max"],
  "classes": {
    "T": { "max_files": 2, "max_dirs": 99, "plan": "none", "mode": "inline", "builder": null, "verifier": null, "budget_usd": 1,
           "note": "<=2 files, one-sentence diff, no risk hits; forge-check record required at close" },
    "S": { "max_files": 3, "max_dirs": 2, "plan": "inline", "mode": "inline", "builder": null,
           "verifier": { "agent": "forge-verifier", "model": "sonnet", "effort": "medium", "when": "tests_changed", "raise_to": { "model": "opus", "if_importers_gte": 5 } },
           "budget_usd": 3, "note": "<=3 files, <=2 dirs, tests present or added first, no risk hits" },
    "M": { "min_files": 3, "max_files": 10, "max_dirs": 3, "plan": "architect_if_small_else_planner",
           "small": { "max_files": 5, "max_dirs": 2, "risk": "none" },
           "planner": { "agent": "forge-planner", "model": "fable", "effort": "medium" },
           "mode": "single", "steps": 1,
           "builder": { "agent": "forge-builder", "model": "opus", "effort": "medium" },
           "builder_chain": { "agent": "forge-builder", "model": "fable", "effort": "low" },
           "verifier": { "agent": "forge-verifier", "model": "opus", "effort": "medium", "raise_to": { "model": "fable", "if_importers_gte": 10, "if_important_hits": true } },
           "budget_usd": 10, "budget_usd_chain": 12 },
    "W": { "plan": "planner", "planner": { "agent": "forge-planner", "model": "fable", "effort": "high" },
           "mode": "single", "steps": 1,
           "builder": { "agent": "forge-builder-wide", "model": "fable", "effort": "low", "retry_effort": "medium", "max_tool_calls": 250 },
           "verifier": { "agent": "forge-verifier", "model": "fable", "effort": "medium" },
           "budget_usd": 25, "expected_premium": true },
    "L": { "plan": "planner", "planner": { "agent": "forge-planner", "model": "fable", "effort": "high" },
           "mode": "sequential", "min_units": 3,
           "unit_builder": { "agent": "forge-builder-s", "model": "sonnet", "effort": "medium" },
           "unit_builder_mechanical": { "agent": "forge-mechanic", "model": "haiku", "effort": "medium" },
           "unit_builder_m_sized": { "agent": "forge-builder", "model": "opus", "effort": "medium" },
           "unit_verifier": { "agent": "forge-verifier", "model": "sonnet", "effort": "medium" },
           "spot_check": { "agent": "forge-verifier", "model": "fable", "effort": "medium", "fraction": 0.2, "min": 1 },
           "budget_usd_per_unit": 2, "budget_multiplier": 1.2 },
    "X": { "plan": "inline", "mode": "inline", "builder": null, "architect_effort": "medium",
           "verifier": { "agent": "forge-verifier", "model": "fable", "effort": "medium", "when": "always" },
           "budget_usd": 30, "expected_premium": true }
  },
  "risk_overlay": {
    "inline_classes": ["T", "S"],
    "inline_effort": "medium",
    "builder_floor": { "agent": "forge-builder", "model": "fable", "effort": "low" },
    "forbidden_agents": ["forge-builder-s", "forge-mechanic"],
    "verifier": { "agent": "forge-verifier", "model": "fable", "effort": "medium" },
    "budget_multiplier": 1.5,
    "requires_rollback": true,
    "requires_human_ack": true
  },
  "rules": {
    "parallel_requires": { "min_disjoint_units": 3, "worktree_isolation": true },
    "cheap_first_requires_tests_present": true,
    "effort_before_model_tags": ["skipped-file", "no-check-run", "not-double-checked"],
    "ladder": ["sonnet/medium", "opus/medium", "fable/low", "fable/medium"],
    "max_attempts_without_ruling": 3,
    "max_verify_attempts_without_ruling": 2,
    "env_tags_do_not_escalate": ["env-cannot-run"],
    "advisory_signals_raise_only": ["importers", "recent_cochanges", "important_hits"],
    "gc_flip_min_measured_rows": 10,
    "gc_escalation_rate_warn": 0.4
  }
}
